{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "*": ["*"]
    }
  },
  "include": [
    "web/static/js/**/*.js",
    "web/static/js/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "web/static/vendor",
    "dist"
  ]
}
